# ==================== 服务 ====================
# 容器内监听端口固定 8080（被 compose 里的 environment 覆盖），
# 集群外暴露的宿主端口由 HOST_PORT 控制。
SERVER_PORT=8080
HOST_PORT=8080
APP_ENV=production

# ==================== 鉴权：管理面 + 每应用上传 key ====================
# 管理面密钥（必填，逗号分隔可配多把以便无停机轮换）。
# 用于 /api/v1/admin/*：创建 app、签发/轮换/吊销上传 key、启用/停用 app、
# release 下架(yank)/恢复(restore)、审计日志、用量统计。
# 生成方式: openssl rand -hex 32
# 注意：未配置时服务会直接启动失败（管理面不允许裸奔）；改完需重启容器生效。
ADMIN_API_KEYS=

# 上传鉴权模式：scoped(默认) / dual / legacy
#   scoped：只接受 app 专属上传 key（gxu_live_<keyId8>_<43字符>），新部署/迁移完成后用这个
#   dual  ：迁移期，先按专属 key 解析，失败再回退旧 UPLOAD_API_KEY（受下面白名单限制）
#   legacy：回滚期，只认旧 UPLOAD_API_KEY；管理面 admin API 仍可用
UPLOAD_AUTH_MODE=scoped

# 旧版全局上传 key（legacy）。仅 dual / legacy 模式使用，scoped 模式下忽略。
# 迁移期先保留原值不动；切到 scoped 并观察审计日志中 actor_type=legacy 的用量归零后，
# 过一段观察期再删除这三项。
UPLOAD_API_KEY=

# dual 模式旧全局 key 允许上传的渠道白名单（逗号分隔，如 schedule,schedule-beta；空=不限制）。
# 建议迁移期显式填上，避免旧 key 还能给别的渠道发版。
UPLOAD_LEGACY_APPKEYS=

# 每把上传 key 的令牌桶限流（默认约 12 次/分钟）
UPLOAD_RATE_RPS=0.2
UPLOAD_RATE_BURST=3

# 管理面按 IP 限流（默认约 6 次/分钟）
ADMIN_RATE_RPS=0.1
ADMIN_RATE_BURST=5

# 新建 app 未指定时的每自然日上传次数上限；幂等重传不计数（app 级可单独覆盖）
DEFAULT_DAILY_UPLOAD_LIMIT=20

# ---- 迁移 runbook 摘要（完整版见 README.md「迁移 runbook」）----
# 1) 部署前：在 .env 加 ADMIN_API_KEYS=<openssl rand -hex 32>，设 UPLOAD_AUTH_MODE=dual，
#    保留原 UPLOAD_API_KEY；然后启动新镜像（缺 ADMIN_API_KEYS 会启动失败）。
# 2) 用 admin API 给 schedule / schedule-beta 各签发一把 key（明文只返回一次）。
# 3) 更新 GitHub Actions secret SCHEDULE_UPLOAD_KEY 与 .beta-release.env 的 UPDATE_API_KEY。
# 4) 观察 audit_logs 中 actor_type=legacy 的用量归零后，切 UPLOAD_AUTH_MODE=scoped。
# 5) 保留旧配置一个观察期后删除。回退：UPLOAD_AUTH_MODE 改回 dual/legacy 并回滚旧镜像。
# 注意：旧镜像不认识 release 的 yank 状态，回退旧镜像前先确认没有 yank 过的 release。

# ==================== 数据库 ====================
# 默认由 docker-compose 起一个 MySQL 容器（服务名 mysql），库名/账号/密码就用下面这几项：
#   DB_NAME 会被建成库；DB_USER=root 时沿用镜像的 root，否则自动另建该账号并授权。
# 以下三行仅在使用外部实例（如阿里云 RDS）时生效，需要自己建库建用户。
# 用外部实例时在下面补 COMPOSE_DB_HOST=<RDS 地址>（compose 会覆盖容器内的 DB_HOST），
# 并只起 app：docker compose up -d --no-deps app；RDS 白名单需放行服务器 IP。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=schedule
DB_USER=schedule
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
# 外部实例地址（留空则容器内连 compose 的 mysql 服务）
# COMPOSE_DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com
# MySQL 映射到宿主的端口，3306 被占用时可改（仅影响宿主直连，不影响容器内 app）
# MYSQL_HOST_PORT=3306
# 升级前建议备份（表结构变更主要是 apps/releases 加列 + 新表 app_upload_keys/audit_logs，
# GORM AutoMigrate 会自动完成；也可手工执行 migrations/001_per_app_keys.sql）。

# ==================== 阿里云 OSS ====================
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 预签名 URL 有效期（秒），仅 CDN_BASE_URL 留空时使用
OSS_SIGN_EXPIRE_SECONDS=3600

# ==================== 下载地址 ====================
# 非空：下载地址 = CDN_BASE_URL + "/" + OSS key（要求桶公共读或 CDN 回源可读）
# 留空：返回 OSS 预签名 URL（桶私有场景）
CDN_BASE_URL=
# 比如 CDN_BASE_URL=https://cdn.your-domain.com

# ==================== 行为开关 ====================
# 全局单文件上传上限（MB）。app 可在此基础上再收紧（admin API 的 maxUploadMB）。
MAX_UPLOAD_MB=512
# 允许发布低于当前最新 versionCode 的包（回滚），默认 false 拒绝；
# app 级也可单独开启（admin API 的 allowDowngrade），任一为 true 即允许。
ALLOW_DOWNGRADE=false
# 前端构建产物目录：非空且存在时，本服务会同时静态托管官网（同源，无需 CORS）。
# Docker 镜像里已内置 WEB_DIR=/app/web，compose 也会显式传入，所以这里一般不用管。
# 只有「不用 Docker、本机直接跑二进制」时才需要，例如：WEB_DIR=frontend/dist
# 注意：千万别在这里写空的 WEB_DIR= ，env_file 会覆盖掉镜像里的默认值，导致 / 返回 404。
# WEB_DIR=frontend/dist

# 允许跨域读取公开接口的来源，逗号分隔；"*" 表示不限制。
# 官网单独部署在别的域名时，这里至少填上官网域名（例如 https://update.example.com,https://laoin114514.github.io）
CORS_ALLOW_ORIGINS=*

# 公开接口（latest / healthz）的每 IP 限流
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
