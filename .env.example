# ============================================================
# 更新服务配置（docker compose 通过 env_file 读取）
# 容器内 DB_HOST/DB_PORT/SERVER_PORT/WEB_DIR 由 docker-compose.yml 固定，
# 不需要在这里配置；限流、上传大小等其它项使用 internal/config 的默认值。
# ============================================================

# ---------- 服务 ----------
APP_ENV=production
# 宿主暴露端口（容器内固定 8080）
HOST_PORT=8080

# ---------- 鉴权 ----------
# 管理面密钥（/api/v1/admin/*），生成命令：openssl rand -hex 32
# 支持逗号分隔多把实现无停机轮换，例如 key1,key2
ADMIN_API_KEYS=please-change-me-to-a-long-random-string

# ---------- MySQL ----------
DB_NAME=schedule
DB_USER=schedule
DB_PASSWORD=change-me

# ---------- 阿里云 OSS / CDN ----------
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 非空时下载地址 = CDN_BASE_URL + 对象 key（留空则用 OSS 预签名 URL）
CDN_BASE_URL=
