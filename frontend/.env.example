# 版本更新服务地址：留空表示使用同源 /api（推荐生产环境由反向代理指向 Go 服务）
VITE_API_BASE_URL=
# 更新服务中的应用标识，与上传 workflow 的 appKey 保持一致
VITE_APP_KEY=schedule
# 仅开发用：vite dev server 把 /api 代理到该地址
VITE_PROXY_TARGET=http://localhost:8080

# ---- 真实截图占位（留空则使用内置的 HTML 还原界面）----
# 图片放到 public/screenshots/ 下，然后填相对路径，例如 ./screenshots/hero.png
VITE_SHOT_HERO=
VITE_SHOT_SCHEDULE=
VITE_SHOT_PREV=
VITE_SHOT_NEXT=
VITE_SHOT_APPEARANCE_LIGHT=
VITE_SHOT_APPEARANCE_DARK=
VITE_SHOT_WIDGET_COUNTDOWN=
VITE_SHOT_WIDGET_TODAY=
VITE_SHOT_WIDGET_UPCOMING=
VITE_SHOT_WIDGET_WEEK=
